{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Status backend: scoring API + on-chain score publisher (runs on a VPS / droplet)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "tsx scripts/e2e.ts",
    "setup-registry": "tsx --env-file-if-exists=.env scripts/setup-registry.ts",
    "publish-scores": "tsx --env-file-if-exists=.env scripts/publish-scores.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@status/core": "*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
