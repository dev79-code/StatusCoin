# ---------- Status backend (droplet) ----------
PORT=8080
# Comma-separated list of allowed browser origins (your Vercel domains)
CORS_ORIGINS=https://status.yourdomain.com,https://your-project.vercel.app,http://localhost:3000

# Solana
RPC_URL=https://api.devnet.solana.com
STATUS_PROGRAM_ID=CEZg25V3N7Z6Qwe9Zi9sH7xoWjan3JFMN3JeHNpZUaNm

# Scorer authority keypair (signs score publishes). Path to a solana-keygen JSON file.
# In docker-compose this is mounted at /run/secrets/scorer.json
SCORER_KEYPAIR=/run/secrets/scorer.json
# Publish newly scored wallets on-chain automatically
AUTO_PUBLISH=true
PUBLISH_INTERVAL_SEC=30
RESCORE_AFTER_HOURS=24

# Scoring data. Empty = demo mode (fake but deterministic histories).
HELIUS_API_KEY=
# Optional AI roasts
ANTHROPIC_API_KEY=
ROAST_MODEL=

DB_PATH=/data/status.db

# Shared secret so the Vercel frontend's server-side requests skip the per-IP rate limit.
# Generate with: openssl rand -hex 32   (set the same value as STATUS_API_KEY on Vercel)
INTERNAL_API_KEY=
RATE_LIMIT_PER_MIN=60
# Set true to allow *.vercel.app preview deployments through CORS
CORS_ALLOW_VERCEL_PREVIEWS=false

# Only used by docker-compose / Caddy for HTTPS
API_DOMAIN=api.yourdomain.com
