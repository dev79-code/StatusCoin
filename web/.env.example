# ---------- Status frontend (Vercel) ----------
# Your droplet API (HTTPS via Caddy)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Solana RPC used by the browser (wallet, launch tx) and token pages. Use a Helius RPC URL in production.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Must match declare_id! in programs/status-hook
NEXT_PUBLIC_STATUS_PROGRAM_ID=CEZg25V3N7Z6Qwe9Zi9sH7xoWjan3JFMN3JeHNpZUaNm
# Public URL of the site (used for share links + OG images)
NEXT_PUBLIC_SITE_URL=https://status.yourdomain.com

# Server-only secret, same value as INTERNAL_API_KEY on the droplet
STATUS_API_KEY=
